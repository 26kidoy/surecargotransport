{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "name": "your-app-name",
    "version": "1.0.0",
    "description": "Your Laravel 13 + Capacitor App",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "sync": "npx cap sync",
        "sync:android": "npx cap sync android",
        "open:android": "npx cap open android",
        "build:android": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
        "build:android:clean": "npm run build && npx cap sync android && cd android && gradlew.bat clean && gradlew.bat assembleDebug",
        "build:release": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease",
        "install:android": "adb install android/app/build/outputs/apk/debug/app-debug.apk",
        "cap": "npx cap"
    },
    "devDependencies": {
        "@popperjs/core": "^2.11.6",
        "@tailwindcss/vite": "^4.0.0",
        "bootstrap": "^5.2.3",
        "concurrently": "^9.0.1",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.1",
        "pusher-js": "^8.5.0",
        "sass": "^1.56.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.4.2",
        "@capacitor/cli": "^8.4.2",
        "@capacitor/core": "^8.4.2"
    }
}
